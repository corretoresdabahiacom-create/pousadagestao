rules_version = '2';

// Cloud Storage: tudo privado. Documentos pessoais e comprovantes só por URL assinada
// gerada em Cloud Function. Logomarca e fotos de quartos: leitura por membros do tenant.

service firebase.storage {
  match /b/{bucket}/o {

    match /tenants/{tenantId}/branding/{file} {
      allow read: if request.auth != null && request.auth.token.tenantId == tenantId;
      allow write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.role == 'owner'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /tenants/{tenantId}/rooms/{file} {
      allow read: if request.auth != null && request.auth.token.tenantId == tenantId;
      allow write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.role in ['owner', 'admin']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Documentos pessoais, comprovantes e anexos: sem acesso direto do cliente.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
